# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# OMDB API key — free at https://www.omdbapi.com/apikey.aspx  (1,000 req/day)
OMDB_API_KEY=your_omdb_key_here

# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Use ONLY the anon/public key here — never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API key — https://aistudio.google.com/app/apikey
# Used server-side by /api/story and /api/dialogue routes.
GEMINI_API_KEY=your_gemini_api_key_here

# Public app URL (set to your Cloudflare Workers domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: future backend API base URL
NEXT_PUBLIC_API_URL=https://api.scriptmind.ai/v1

# Script analysis FastAPI (POST /api/v1/scripts/analyse) — default http://127.0.0.1:8000
NEXT_PUBLIC_ANALYSE_API_URL=http://127.0.0.1:8000

# Hugging Face API token — https://huggingface.co/settings/tokens
# Used server-side ONLY by /api/visualize (Stable Diffusion image generation).
# Never prefix with NEXT_PUBLIC_ — keep this secret.
HF_API_TOKEN=your_huggingface_token_here
